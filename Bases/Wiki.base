filters:
  and:
    - file.inFolder("wiki")
    - file.ext == "md"
formulas:
  days_since_update: if(updated, (today() - date(updated)).days, "")
properties:
  formula.days_since_update:
    displayName: Stale (days)
  type:
    displayName: Type
  status:
    displayName: Status
  tags:
    displayName: Tags
views:
  - type: table
    name: By Type
    groupBy:
      property: type
      direction: ASC
    order:
      - file.basename
      - status
      - updated
    columnSize:
      file.basename: 220
  - type: table
    name: Recent
    order:
      - updated
    direction: DESC
    columnSize:
      file.basename: 220
  - type: table
    name: All
    order:
      - file.basename
      - type
      - status
      - tags
      - updated
      - formula.days_since_update
    columnSize:
      file.basename: 220
