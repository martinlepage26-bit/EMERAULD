{
  "name": "figma-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for reading Figma design context from Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "check": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector@latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.11.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260420.1",
    "typescript": "^6.0.3",
    "wrangler": "4.85.0"
  }
}
