{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "h3rme3-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "H3RME3",
        "name": "H3RME3"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["H3RME3"]
    }
  ]
}

