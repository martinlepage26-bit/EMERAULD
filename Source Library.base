    order:
      - file.name
      - author
      - year
  - type: table
    name: Theme — Social Theory
    filters:
      and:
        - file.hasTag("social_theory")
    order:
      - file.name
      - author
      - year
  - type: table
    name: Theme — Social Psychology & Interaction
    filters:
      and:
        - file.hasTag("social_psychology")
