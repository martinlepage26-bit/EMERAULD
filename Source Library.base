filters:
  or:
    - file.inFolder("references")
    - file.hasTag("raw-source")
    - file.hasTag("reference")
views:
  - type: table
    name: Reference Library
    filters:
      and:
        - file.inFolder("references")
    order:
      - file.name
      - author
      - year
      - tags
  - type: table
    name: References by Year
    filters:
      and:
        - file.inFolder("references")
    order:
      - year
      - author
      - file.name
  - type: table
    name: Theme — AI Governance
    filters:
      and:
        - file.hasTag("ai_governance")
    order:
      - file.name
      - author
      - year
  - type: table
    name: Theme — Governance & Institutions
    filters:
      and:
