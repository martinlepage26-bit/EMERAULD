{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top-level name is deliberately NOT "kairos": a bare `wrangler deploy`
  // resolves here and must not be able to overwrite the live Worker with dev
  // vars. It creates a harmless "kairos-dev" Worker instead. Production is the
  // env.production block below, deployed via `npm run deploy`.
  "name": "kairos-dev",
  // These credentials can see two accounts, so a bare deploy cannot pick one
  // non-interactively. This is the account the kairos Worker and the
  // kairos-dashboard Pages project both live in.
  "account_id": "1713c51cc6fbcf8d7143526b93495b76",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Top level is the safe development default: every outbound platform call is
  // simulated and PUBLIC_BASE_URL points at wrangler dev. Live values exist
  // only under env.production. Note the resource bindings below still name the
  // production D1/KV/R2 ids, so `wrangler dev --remote` and env-less
  // `wrangler d1 execute --remote` touch live data; local dev simulates them.
  // test/config.test.ts enforces the dev/production invariants.
  "vars": {
    "ENVIRONMENT": "development",
    // Drafting model. Opus 5 is the default; the operator may set a different
    // supported id per deployment. Cost implications are in docs/UNIT-ECONOMICS.md.
    "DRAFT_MODEL": "claude-opus-5",
    "STRATEGY_MODEL": "claude-opus-5",
    // Every outbound platform call is simulated unless this is "false". Keeps the
    // whole engine runnable end to end without live creator credentials.
    "DRY_RUN": "true",
    // Queue drain sizing per cron tick.
    "JOB_BATCH_SIZE": "25",
    "PUBLIC_BASE_URL": "http://localhost:8789",
    // Browser origins allowed to call this API cross-origin. The dashboard is a
    // separate Next.js app on its own origin, so without a match here the
    // browser blocks every one of its requests. Empty means no cross-origin
    // browser access at all. Dev lists the Next dev server, which talks to this
    // block via NEXT_PUBLIC_API_BASE (see frontend/.env.example).
    "DASHBOARD_ORIGINS": "http://localhost:3000"
  },
  "d1_databases": [
    {
      // Binding stays "DB": the code reads env.DB. Wrangler's create output
      // suggests naming the binding after the database, which would break it.
      "binding": "DB",
      "database_name": "kairos",
      "database_id": "c3d0eda8-7f7d-4db9-b47f-68a7f52d8bc8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kairos-media"
    }
  ],
  "kv_namespaces": [
    {
      // Binding is "CACHE" because the code reads env.CACHE. The namespace
      // itself is titled "kairos-cache" on Cloudflare: binding name and
      // namespace title are independent, and a product-specific title keeps
      // these rate-limit counters out of another project's namespace.
      "binding": "CACHE",
      "id": "938c54e8c6f84f039db3559f1a81f29d"
    }
  ],
  // Triggers and observability are inheritable keys: env.production gets these
  // same crons without redeclaring them.
  "triggers": {
    "crons": [
      // Drain the durable job queue.
      "* * * * *",
      // Enqueue due publishes and sync inbound messages.
      "*/15 * * * *",
      // Collect performance metrics on published posts.
      "17 * * * *",
      // Daily 05:10 UTC: top up the planning horizon, rebalance pillar weights.
      "10 5 * * *",
      // Daily 06:20 UTC: subscription reconciliation and dunning.
      "20 6 * * *"
    ]
  },
  "env": {
    "production": {
      // Explicit name: production deploys target the existing "kairos" Worker,
      // keeping its workers.dev URL and the secrets already uploaded to it
      // (a nameless env would deploy a separate "kairos-production" Worker
      // with neither).
      "name": "kairos",
      // vars and bindings are non-inheritable, so everything the Worker reads
      // must be restated here in full.
      "vars": {
        "ENVIRONMENT": "production",
        "DRAFT_MODEL": "claude-opus-5",
        "STRATEGY_MODEL": "claude-opus-5",
        // Live outbound platform calls.
        "DRY_RUN": "false",
        "JOB_BATCH_SIZE": "25",
        // Stripe checkout return pages and published media URLs are built on
        // this origin, so it must be a domain this Worker actually serves.
        "PUBLIC_BASE_URL": "https://kairos.govern-ai.ca",
        // The deployed dashboard's canonical origin, and only that. Matching is
        // exact, so per-deployment Pages preview URLs (<hash>.kairos-dashboard
        // -dy4.pages.dev) are not admitted; add one here to test a preview
        // against live data. localhost is deliberately absent: local work runs
        // against a local Worker via NEXT_PUBLIC_API_BASE.
        "DASHBOARD_ORIGINS": "https://kairos-dashboard-dy4.pages.dev"
      },
      "routes": [
        {
          "pattern": "kairos.govern-ai.ca",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairos",
          "database_id": "c3d0eda8-7f7d-4db9-b47f-68a7f52d8bc8",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "kairos-media"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "938c54e8c6f84f039db3559f1a81f29d"
        }
      ]
    }
  }
}
